Mods: {
	XianXia: {
		Items: {
			LowGradeSpiritStone: {
				DisplayName: Low-Grade Spirit Stone
				Tooltip: A weak spirit stone condensed in shallow spirit veins. Picking it up awakens spiritual energy awareness.
			}
			SpiritGel: {
				DisplayName: Spirit Gel
				Tooltip: Spiritual gel left inside wandering spirit slimes.
			}
			QiDrawingTalisman: {
				DisplayName: Qi-Drawing Talisman
				Tooltip: Use to enter Qi Awakening and restore a little spiritual energy.
				Awakened: You feel a thread of spiritual energy moving through your meridians.
			}
			WoodgrainFlyingSword: {
				DisplayName: Woodgrain Flying Sword
				Tooltip: Costs 4 spiritual energy to release a returning wooden flying sword.
			}
			SpiritwoodCrossbow: {
				DisplayName: Spiritwood Crossbow
				Tooltip: Costs 2 spiritual energy to fire a spirit bolt.
			}
			SpiritVeinIncense: {
				DisplayName: Spirit Vein Incense
				Tooltip: Summons the Spirit Vein Wyrm. This is the first cultivation trial.
			}
		}
		Projectiles: {
			WoodgrainSwordProjectile.DisplayName: Woodgrain Flying Sword
			SpiritBoltProjectile.DisplayName: Spirit Bolt
		}
		NPCs: {
			WanderingSpiritSlime.DisplayName: Wandering Spirit Slime
			TalismanBat.DisplayName: Talisman Bat
			ShatteredJadeWorm.DisplayName: Shattered Jade Worm
			SpiritVeinWyrm.DisplayName: Spirit Vein Wyrm
			ShatteredJadeWyrmMinion.DisplayName: Spirit Vein Segment
			Commission: {
				Button: Commission
				Unavailable: There is no suitable commission for you right now.
				AlreadyClaimed: This commission has already been settled. The fallen sect records slowly, but accurately.
				HerbSectApprentice: {
					Locked: The old garden trouble still stands. Defeat the Garden Warden, then I can release the herb sect's share.
					Claimed: "The garden roots are recorded. Sect reputation +{0}; current reputation {1}."
				}
				WanderingArtificer: {
					Locked: The black furnace is still ringing. Defeat the Black Furnace Iron Golem before I hand over its lower-forge materials.
					Claimed: "The furnace debt is settled. Sect reputation +{0}; current reputation {1}."
				}
				TribulationObserver: {
					Locked: The Thunder Marsh Jiao has not fallen, so the lightning debt is not written yet. Walk the thunder clouds first.
					Claimed: "The lightning debt is recorded. Sect reputation +{0}; current reputation {1}."
				}
				ArchiveScrollSpirit: {
					Locked: The Formless Sword Soul still guards the old scrolls. The archive will not open before the trial is passed.
					Claimed: "The old scrolls accept your sword marks. Sect reputation +{0}; current reputation {1}."
				}
				FallenHeavenMessenger: {
					Locked: The Heaven Tablet Guardian has not stepped aside. Make the old court hear your name first.
					Claimed: "The tablet debt is sealed. Sect reputation +{0}; current reputation {1}."
				}
			}
		}
		Tiles: {
			SpiritOreTile.MapEntry: Spirit Ore
			SpiritMossTile.MapEntry: Spirit Moss
		}
		Biomes: {
			ShallowSpiritVeinsBiome.DisplayName: Shallow Spirit Veins
		}
	}
}
