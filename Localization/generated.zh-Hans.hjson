Mods: {
	XianXia: {
		Items: {
			ArtifactBlankShard: {
				DisplayName: "器胚碎片"
				Tooltip: "未完成的法器胚胎。在器胚炉处用于铸造飞剑、阵盘和饰品。"
			}
			BrokenHeavenCrownSeal: {
				DisplayName: "残天冠印"
				Tooltip: "旧天庭的破裂冠印。佩戴后大幅提升伤害，但会降低防御。"
			}
			BrokenHeavenDecree: {
				DisplayName: "残天法令"
				Tooltip: "仍带有审判之力的天庭法令。释放可穿透方块的裁决光束。"
			}
			CinnabarTalismanFlameItem: {
				DisplayName: "朱砂符火"
				Tooltip: "燃烧朱砂的符箓。命中敌人时施加灼热烈焰。"
			}
			CloudpiercerFlyingSword: {
				DisplayName: "破云飞剑"
				Tooltip: "穿云而过的飞剑。撞击后释放次级云气弹。"
			}
			DaoSeveringDust: {
				DisplayName: "斩道尘"
				Tooltip: "大道被切断后留下的细尘。用于尝试最终突破至斩道境。"
			}
			DaoSeveringRing: {
				DisplayName: "斩道环"
				Tooltip: "斩断旧道羁绊的戒指。大幅提升伤害，但灵气消耗略增。"
			}
			FormlessSwordWheel: {
				DisplayName: "无相剑轮"
				Tooltip: "无形无相的旋转剑阵。可穿透多个敌人，拥有局部无敌帧。"
			}
			FoundationPill: {
				DisplayName: "筑基丹"
				Tooltip: "稳固根基的丹药。用于尝试突破至筑基境。"
			}
			FurnaceHeartRing: {
				DisplayName: "炉心戒"
				Tooltip: "以炉心锻造的戒指。提供额外防御。"
			}
			FurnaceSlagIron: {
				DisplayName: "炉渣铁"
				Tooltip: "在黑炉中淬炼的铁渣。法器铸造与炼器的核心材料。"
			}
			GardenBrokenKey: {
				DisplayName: "守园残钥"
				Tooltip: "药园中寻得的断裂钥匙。与灵石合成可铸造Boss召唤物。"
			}
			GreenwoodArrayPlate: {
				DisplayName: "青木阵盘"
				Tooltip: "以青木雕刻的阵法盘。部署一个恢复领域，为范围内友方回复生命与灵气。"
			}
			GreenwoodRoot: {
				DisplayName: "青木根"
				Tooltip: "饱含草木精华的根茎。炼丹与法器铸造的基础材料。"
			}
			HeavenDaoFragment: {
				DisplayName: "天道碎片"
				Tooltip: "旧天道的碎片。用于尝试突破至斩灵境。"
			}
			HeavenTabletRubbing: {
				DisplayName: "天碑拓片"
				Tooltip: "坠天碑文的拓印。与灵石合成可铸造Boss召唤物。"
			}
			LightningWardJade: {
				DisplayName: "避雷玉佩"
				Tooltip: "避雷护身的玉佩。提升耐力，并随时间缓慢降低灵压。"
			}
			Moonbone: {
				DisplayName: "月骨"
				Tooltip: "月骸天渊中的骨片。用于尝试突破至渡劫境。"
			}
			MoonboneDharmaSword: {
				DisplayName: "月骨法剑"
				Tooltip: "以月骨锻造的法剑。弹片命中后减速，可贯穿两次。"
			}
			MoonboneRitualTalisman: {
				DisplayName: "月骨祭符"
				Tooltip: "月骨仪式所用的符箓。与灵石合成可铸造Boss召唤物。"
			}
			NascentSoulJadeBox: {
				DisplayName: "元婴玉匣"
				Tooltip: "温养元婴的玉匣。灵气上限提升30点。"
			}
			OldFurnaceEmber: {
				DisplayName: "旧炉火种"
