Mods: {
	XianXia: {
		Items: {
			SectLedger: {
				DisplayName: Sect Ledger
				Tooltip: Use to read the next cultivation objective recorded by the fallen sect.
				Guidance: {
					SectReputation: "Sect reputation: {0}."
					AwakenQi: The ledger points to shallow spirit veins: craft or use a Qi-Drawing Talisman to awaken spiritual energy.
					SpiritVeinWyrm: The first debt is under the earth: craft Spirit Vein Incense and defeat the Spirit Vein Wyrm.
					Foundation: Your meridians are open, but your base is loose: refine advancement pills and reach Foundation.
					GardenWarden: The pages smell of old herbs: explore the Greenwood Herb Garden and challenge the Garden Warden.
					BlackFurnace: The ink turns hot near ore: enter the Black Furnace Lode and defeat the Black Furnace Iron Golem.
					GoldenCore: The ledger circles a star eclipse formula: gather the required core material and form your Golden Core.
					SwordSoul: The trial seal is awake: use the Sect Trial Token and defeat the Formless Sword Soul.
					NascentSoul: A torn heavenly decree answers your name: use the Old Heaven Dao Scroll to condense a Nascent Soul.
					HeavenTablet: Fallen palace dust stains the page: challenge the Heaven Tablet Guardian.
					DaoSevering: "Sect reputation: {0}. Continue defeating major threats, withstand tribulation, and prepare to sever your dao."
					Endgame: "Sect reputation: {0}. The ledger is nearly blank; only the Old Heaven Dao Core still waits beyond the ruined sky."
					CommissionHerbReady: "Commission available: the Herb Sect Apprentice is ready to settle the garden account."
					CommissionFurnaceReady: "Commission available: the Wandering Artificer is waiting for the furnace materials account."
					CommissionThunderReady: "Commission available: the Tribulation Observer has recorded the thunder marsh aftermath."
					CommissionArchiveReady: "Commission available: the Archive Scroll Spirit will release an old trial record."
					CommissionHeavenReady: "Commission available: the Fallen Heaven Messenger has prepared the tablet remnant account."
					CommissionNoneReady: "No sect commissions are ready to claim."
				}
			}
			TribulationGauge: {
				DisplayName: Tribulation Gauge
				Tooltip: Use to read current spirit pressure and tribulation status.
				Gauge: {
					Pressure: "Spirit pressure: {0}."
					Active: "Tribulation active: {0}s remaining, intensity {1}."
					Danger: The pressure is dangerous. Use warding pills or wait before advancing.
					Warning: The pressure is rising. Prepare resistance before inviting thunder.
					Stable: The pressure is stable.
				}
			}
		}
	}
}
