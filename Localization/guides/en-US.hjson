Mods: {
	XianXia: {
		Items: {
			SectLedger: {
				DisplayName: Sect Ledger
				Tooltip: Use to read your realm, energy, pressure, trial status and next cultivation objective. Right-click for biome fishing supplies.
				Guidance: {
					SectReputation: "Sect reputation: {0}."
					AwakenQi: The ledger points to shallow spirit veins: craft or use a Qi-Drawing Talisman to awaken spiritual energy.
					SpiritVeinWyrm: The first debt is under the earth: craft Spirit Vein Incense and defeat the Spirit Vein Wyrm.
					Foundation: Your meridians are open, but your base is loose: refine advancement pills and reach Foundation.
					GardenWarden: Use [i:XianXia/SummonGardenBrokenKey] in the Greenwood Herb Garden to challenge the Garden Warden.
					BlackFurnace: Use [i:XianXia/SummonOldFurnaceEmber] in the Sunken Furnace Vein to challenge the Black Furnace Iron Golem.
					TribulationCloud: Use [i:XianXia/SummonThunderCallingJade] in Thunder Marsh Clouds to challenge the Tribulation Cloud Avatar.
					ThunderJiao: Use [i:XianXia/SummonThunderCallingJadeThunderMarshJiao] in Thunder Marsh Clouds to challenge the Thunder Marsh Jiao.
					StarWomb: At night, use [i:XianXia/SummonStarAbyssMembrane] in the Star Abyss Rift to challenge the Abyssal Star Womb.
					GoldenCore: The ledger circles a star eclipse formula: gather the required core material and form your Golden Core.
					SwordSoul: Use [i:XianXia/SummonSectTrialToken] in Ten Thousand Sects Ruins to challenge the Formless Sword Soul.
					MedicineKing: Use [i:XianXia/SummonSectTrialTokenGreenwoodMedicineKingEcho] in the Greenwood Herb Garden to challenge the Medicine King Echo.
					NascentSoul: A torn heavenly decree answers your name: use the Old Heaven Dao Scroll to condense a Nascent Soul.
					HeavenTablet: Use [i:XianXia/SummonHeavenTabletRubbing] in the Fallen Heaven Palace to challenge the Heaven Tablet Guardian.
					BrokenInspector: Use [i:XianXia/SummonHeavenTabletRubbingBrokenHeavenInspector] in the Fallen Heaven Palace to challenge the Broken Heaven Inspector.
					TribulationStage: Gather Moonbone in the Moonbone Abyss, then hold and use it to reach Tribulation.
					MoonboneImmortal: At night, use [i:XianXia/SummonMoonboneRitualTalisman] in the Moonbone Abyss to challenge the Moonbone Immortal.
					DaoSevering: "Sect reputation: {0}. The Old Heaven Dao Core has fallen. Use Dao Severing Dust, then survive your final breakthrough tribulation."
					OldHeavenCore: At night, use [i:XianXia/SummonMoonboneRitualTalismanOldHeavenDaoCore] in the Moonbone Abyss to challenge the Old Heaven Dao Core.
					Endgame: "Sect reputation: {0}. The core has fallen and your final tribulation is complete. Your cultivation path has reached Dao Severing."
					CommissionHerbReady: "Commission available: the Herb Sect Apprentice is ready to settle the garden account."
					CommissionFurnaceReady: "Commission available: the Wandering Artificer is waiting for the furnace materials account."
					CommissionThunderReady: "Commission available: the Tribulation Observer has recorded the thunder marsh aftermath."
					CommissionArchiveReady: "Commission available: the Archive Scroll Spirit will release an old trial record."
					CommissionHeavenReady: "Commission available: the Fallen Heaven Messenger has prepared the tablet remnant account."
					CommissionNoneReady: "No sect commissions are ready to claim."
				}
			}
			TribulationGauge: {
				DisplayName: Tribulation Gauge
				Tooltip: Use to read current spirit pressure and tribulation status.
				Gauge: {
					Pressure: "Spirit pressure: {0}."
					Active: "Tribulation active: {0}s remaining, intensity {1}."
					Comprehension: "Tribulation comprehension bonus: +{0} max spiritual energy."
					Danger: The pressure is dangerous. Use warding pills or wait before advancing.
					Warning: The pressure is rising. Prepare resistance before inviting thunder.
					Stable: The pressure is stable.
				}
			}
		}
	}
}
