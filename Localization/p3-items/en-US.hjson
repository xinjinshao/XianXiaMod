Mods: {
	XianXia: {
		Items: {
			GreenwoodInscriptionNeedle: {
				DisplayName: "Greenwood Inscription Needle"
				Tooltip: "Inscribes mod weapons or accessories with Greenwood recovery effects."
			}
			FurnaceInscriptionNeedle: {
				DisplayName: "Furnace Inscription Needle"
				Tooltip: "Inscribes mod weapons or accessories with armor penetration, heavy strikes or defense."
			}
			ThunderInscriptionNeedle: {
				DisplayName: "Thunder Inscription Needle"
				Tooltip: "Inscribes mod weapons or accessories with attack and movement speed."
			}
			StarAbyssInscriptionNeedle: {
				DisplayName: "Star Abyss Inscription Needle"
				Tooltip: "Inscribes mod weapons or accessories with damage and spiritual pressure drawbacks."
			}
			BrokenHeavenInscriptionNeedle: {
				DisplayName: "Broken Heaven Inscription Needle"
				Tooltip: "Inscribes mod weapons or accessories with critical chance, knockback and higher energy costs."
			}
			InscriptionRemovalStone: {
				DisplayName: "Inscription Removal Stone"
				Tooltip: "Removes an equipment inscription while keeping the equipment and its prefix."
			}
			SmallArtifactPendant: {
				DisplayName: "Small Artifact Pendant"
				Tooltip: "Equipped: +1 energy per regeneration pulse. Hold and use to summon a small spirit for 10 mana (12 base summon damage, 1 minion slot, at most one per player). Right-click its buff to dismiss. Requires a free minion slot."
			}
			FurnaceAshSpiritContract: {
				DisplayName: "Furnace Ash Spirit Contract"
				Tooltip: "Equipped: +8% summon damage. Use 12 mana to summon one Furnace Ash Spirit: 28 base damage, one minion slot, contact inflicts 2 seconds of fire. Cancel its buff to dismiss."
			}
			StarAbyssLarvaContract: {
				DisplayName: "Star Abyss Larva Contract"
				Tooltip: "Equipped: +10% summon damage and +5% spiritual energy cost. In Hardmode use 16 mana to summon one Star Abyss Spirit: 48 base damage, one minion slot, fires a summon bolt every second while keeping its distance. Cancel its buff to dismiss."
			}
			NascentSoulCloneTalisman: {
				DisplayName: "Nascent Soul Clone Talisman"
				Tooltip: "Equipped: +1 minion slot and +12% summon damage. After Plantera use 20 mana to summon a Nascent Soul: 62 base damage, one slot, two bolts at 75% damage every 75 ticks. Cancel its buff to dismiss."
			}
			CelestialPuppetToken: {
				DisplayName: "Celestial Puppet Token"
				Tooltip: "Equipped: +1 minion slot and +14% summon damage. After Golem use 24 mana to summon a Celestial Puppet: 90 base damage, one slot, charges for 90 ticks then dashes for 18 ticks. Contact damage only during the dash. Cancel its buff to dismiss."
			}
			ArchivedImmortalSoulContract: {
				DisplayName: "Archived Immortal Soul Contract"
				Tooltip: "Equipped: +2 minion slots and +18% summon damage. After Moon Lord use 30 mana to summon an Archived Soul: 120 base damage, two slots, three bolts at 75% damage every 90 ticks. Cancel its buff to dismiss."
			}
			LightningAvoidanceRune: {
				DisplayName: "Lightning Avoidance Rune"
				Tooltip: "Grants temporary tribulation resistance for 30 minutes."
			}
			TribulationTrainingToken: {
				DisplayName: "Tribulation Training Token"
				Tooltip: "Restarts the unfinished tribulation of your current realm without another breakthrough item. Reusable; cannot be used during an active or completed trial."
			}
			BlankSectScroll: {
				DisplayName: "Blank Sect Scroll"
				Tooltip: "A blank scroll ready to record sect lore and recipes."
			}
			SpiritHerbSeeds: {
				DisplayName: "Spirit Herb Seeds"
				Tooltip: "Plant on level dirt, grass, jungle grass, Greenwood Soil, Spirit Moss, pots or planter boxes\nGrows through three stages; mature plants glow green\nMature harvest: 1 Greenwood Root and 1–3 seeds; immature harvest: 1 seed\nFlooding pauses growth; lava destroys the plant"
			}
			HeavenDaoRouteHint: {
				DisplayName: "Heaven Dao Route Hint"
				Tooltip: "Use to read all three route effects, requirements and the current world route.\nReusable; spends no route material and changes no world choice."
			}
			EndgameRouteFrame: {
				DisplayName: "Endgame Route Frame"
				Tooltip: "A jade frame that displays your chosen endgame route."
			}
		}
		Buffs: {
			SpringReturnRegenBuff: {
				DisplayName: "Spring Return Regen"
				Description: "The body returns to spring vitality. Life regeneration and spiritual energy recovery are increased."
			}
			StarAbyssCorrosionBuff: {
				DisplayName: "Star Abyss Corrosion"
				Description: "The star abyss corrodes your defenses. Defense reduced and spirit pressure grows."
			}
			ArchiveLockBuff: {
				DisplayName: "Archive Lock"
				Description: "An archive lock restricts your movement. Reduced speed, acceleration, and jump height."
			}
		}
	}
}
