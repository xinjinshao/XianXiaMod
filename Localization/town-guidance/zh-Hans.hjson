{
  "Mods": {
    "XianXia": {
      "TownGuidance": {
        "Dialogue": {
          "HerbSectApprentice": {
            "Ready": "草木有灵，丹火要慢。筑基之前，丹药只是助缘，不是替你走路。",
            "Early": "青木根能养丹，灵石能引气。先凝住第一口真气，再谈筑基。",
            "Pressure": "你的灵压浮在皮肉上，先稳住状态、备好丹药，别急着再破境。",
            "RebuildEnding": "天道重铸，草木还要一季一季地养。你替众生接回了天穹，我替他们留一炉药火。",
            "SeverEnding": "天道已断，药草不会因此停止生长。今后的路没有旧律兜底，带好丹药，也照顾同行的人。",
            "StarAbyssEnding": "星渊已被接纳，陌生的气息也进入了药圃。别把力量当成平静；留意灵压，慢慢适应。"
          },
          "WanderingArtificer": {
            "Ready": "好材料不是拿来供着的。剑、匣、阵盘，都要先敢用坏。",
            "Foundation": "器胚炉已经热了。按配方制作法器，再依各件工具的条件进行成长。",
            "Early": "木剑和短弩够你探灵脉。等灵脉蠕虫伏下，我再教你铸真正的法器。",
            "RebuildEnding": "新的天律需要新的器物。我会修补旧炉，你去试试重天道心，也别忘了让法器继续成长。",
            "SeverEnding": "天道断了，炉火却还听得懂手艺。断天锋给你力量，消耗也更重；一件好法器应当经得起自己的代价。",
            "StarAbyssEnding": "星渊入世，旧材料有了新的去处。星渊契能助你出手，积起的灵压也要由你承受。"
          },
          "TribulationObserver": {
            "Ready": "天雷不是罚，是账。你欠得越明白，挨得越稳。",
            "Early": "天雷不是罚，是账。筑基之后，这账才会真正写上你的名字。",
            "Active": "别躲进屋里数雷。看清落点，留一口灵气，雷过之后才算你自己的境界。",
            "RebuildEnding": "天道重铸，并不意味着往后的雷都肯让路。你改变了世界的方向，修行仍需一步一步走。",
            "SeverEnding": "你斩断了旧天道，却没有替所有人消去修行中的风险。看清自己的状态，下一次试炼仍要认真准备。",
            "StarAbyssEnding": "星渊的力量会积成灵压。佩戴星渊契时，记住增长的不只有伤害；观劫之前先稳住自己。"
          },
          "ArchiveScrollSpirit": {
            "Ready": "宗门毁了，规矩还在。你若想借旧法，就得先付新代价。",
            "Reputation": "你的宗门声望已有 {0}。旧卷认可战绩，也认可耐心。",
            "SwordSoul": "无相剑魂还守着残碑。你若听见剑鸣，不要先拔剑，先听完。",
            "Early": "宗门试炼令不是门票，是债券。等你结成金丹，再来翻旧卷。",
            "RebuildEnding": "这一页我记下了：重铸天道。旧宗门的残卷终于不只记录毁灭，也记录一次修补。",
            "SeverEnding": "这一页我记下了：斩断天道。后人翻到这里，会知道有人选择自己承担前路。",
            "StarAbyssEnding": "这一页我记下了：接纳星渊。经阁会保存这份选择，至于它的代价，要由活着的人继续回答。"
          },
          "FallenHeavenMessenger": {
            "Ready": "旧天道不会回答你，但它留下的碎片仍会索取答案。",
            "Reputation": "你的宗门声望是 {0}，还需更多战绩，才能开放后期宗门补给。",
            "Guardian": "天碑守卫仍在。它不恨你，只是不承认你。",
            "Early": "你还听不见天碑背面的噪音。等元婴成形，再来问旧天道。",
            "RebuildEnding": "你选择了重铸。旧天道核心已倒下，这个世界的路线也已确定；去斩道台制作重天道心，给新的天穹一个支点。",
            "SeverEnding": "你选择了斩断。这个世界不会再接受另一条路线；去斩道台制作断天锋，让自己的锋芒承担选择的代价。",
            "StarAbyssEnding": "你选择了接纳。星渊已成为这个世界的路线；去斩道台制作星渊契，享受它的力量，也留意随之增长的灵压。",
            "CoreDefeated": "旧天道核心已倒下，但这个世界还没有选择路线。达到渡劫境，带上核心掉落的路线材料，到斩道台附近使用；先阅读天庭路线提示，再确认不可更换的世界选择。制作专属奖励还需要另一份路线材料。"
          }
        },
        "Services": {
          "HerbSectApprentice": "炼丹与种植：商店供应丹药和灵草种子；丹药在丹炉合成，品质制作时确定。使用宗门玉简查看当前突破需求。商店价格与使用条件以物品提示为准。",
          "WanderingArtificer": "铭刻与炼器：购买铭针或祛纹石，在器胚炉附近使用工具并选择背包里的目标；淬灵晶、法器觉醒印和法器道化印也使用该入口。界面会列出费用，条件不符时会反馈原因，铭针本身不是饰品。",
          "TribulationObserver": "观劫与重试：商店供应观劫盘和天劫训练令。突破准备请查看宗门玉简；天劫失败后，只有处于可重试状态时才能使用天劫训练令。恢复状态、留意落雷标记再尝试。",
          "ArchiveScrollSpirit": "经阁与器灵：购买宗门玉简查看下一步进度与委托。小器灵坠和器灵契约要手持使用才能召唤，佩戴加成另算；查看契约的魔力、仆从位和世界门槛，取消对应增益可结束召唤。",
          "FallenHeavenMessenger": "终局路线：商店的天庭路线提示提供线索。击败旧天道核心取得路线材料后，在斩道台附近使用材料打开路线界面；先查看效果与费用，确认后世界路线不可更换。"
        }
      }
    }
  }
}
